{
  "manifest_version": 3,
  "name": "Shadow Sentinel",
  "version": "1.0.0",
  "description": "Enterprise shadow AI detection and telemetry browser extension.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shadow Sentinel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "collectors/metadata.js",
        "collectors/ui.js",
        "collectors/interaction.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
